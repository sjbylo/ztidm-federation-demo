        <mxCell id="leg4t" value="&lt;font color=&quot;#999&quot;&gt;dashboard poll&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;" vertex="1" parent="1">
