<mxfile host="app.diagrams.net">
  <diagram name="SPIRE Infrastructure" id="spire-infra">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Cluster 1 box -->
        <mxCell id="c1box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="380" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="c1label" value="&lt;b&gt;Cluster 1&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#3366CC;fontSize=14;" vertex="1" parent="1">
